{
  "name": "pecvd-fab-twin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PECVD FAB Twin - Visual Milestone V1: browser-based inspection of a representative single-wafer CCP PECVD process chamber (Babylon.js).",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "qa:screenshots": "playwright test --grep @screenshots",
    "validate:config": "node --import tsx scripts/validate-config.ts"
  },
  "dependencies": {
    "@babylonjs/core": "9.34.0",
    "@babylonjs/loaders": "9.34.0",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@webgpu/types": "0.1.74",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
